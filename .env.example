# IndustrialCRM Environment Configuration
# Copy this file to .env or set environment variables in your server / Vercel environment

# ==============================================================================
# 1. LOCAL DEVELOPMENT (WAMP / XAMPP)
# ==============================================================================
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=industrial_crm
# DB_USER=root
# DB_PASSWORD=

# ==============================================================================
# 2. VERCEL SERVERLESS DEPLOYMENT (Recommended: TiDB Cloud / Aiven Cloud MySQL)
# ==============================================================================
# Add these environment variables in your Vercel Dashboard:
# (Project -> Settings -> Environment Variables)
#
# NOTE: InfinityFree MySQL (sql300.infinityfree.com) does NOT allow remote connections.
# Use a free cloud MySQL provider such as TiDB Cloud Serverless (5GB free forever) or Aiven.
#
DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_NAME=industrial_crm
DB_USER=your_username.root
DB_PASSWORD=your_secure_password
DB_SSL=true

# Alternative single connection string (if provided by your database provider):
# DATABASE_URL=mysql://username:password@host:port/database?sslmode=verify-ca

# Application Environment (development / production)
APP_ENV=production
